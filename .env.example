# ---- Web UI ----
WEB_PORT=8080

# ---- Music library path on the ZimaOS host ----
# This must point at the folder Navidrome scans. On ZimaOS, media usually lives
# under /DATA. Check your actual path in the ZimaOS Files app, e.g.:
#   /DATA/Media/Music
#   /DATA/AppData/navidrome/music
MUSIC_LIBRARY=/DATA/Media/Music

# ---- File ownership ----
# Set these to the user/group that owns the music share so Navidrome can read
# the downloaded files. On ZimaOS the default admin user is usually 1000:1000.
# Find yours on the host with:  id
PUID=1000
PGID=1000

# ---- Audio settings ----
# mp3 is the most compatible with Navidrome. Options: mp3, m4a, opus, flac
AUDIO_FORMAT=mp3
# 0 = best VBR quality (for mp3). Lower number = higher quality.
AUDIO_QUALITY=0
SEARCH_LIMIT=8

# ---- YouTube authentication (optional) ----
# YouTube may block downloads from server IPs with a "Sign in to confirm you're
# not a bot" / "page needs to be reloaded" error. To fix, export your YouTube
# cookies to cookies.txt (Netscape format) and enable it here:
#   COOKIES_FILE=/cookies.txt
# Leave blank to disable. The host file mounted is ./cookies.txt by default.
COOKIES_FILE=
COOKIES_HOST_FILE=./cookies.txt

# ---- Optional bundled Navidrome (only used with --profile with-navidrome) ----
NAVIDROME_PORT=4533
NAVIDROME_DATA=./navidrome-data
